{
  "files": [
    "dist/src/**",
    "!dist/src/**/*.test.*",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "README.md",
    "docs/api.md",
    "docs/upgrades/**",
    "llms.txt",
    "LICENSE",
    "dist/api.json",
    "dist/errors.json",
    "dist/api-names/**"
  ],
  "name": "@arki/offline",
  "version": "0.1.0",
  "description": "Offline-first building blocks for TanStack apps: a persisted query cache, a replayable mutation queue with dead letters, local collections, PWA caching, and an oRPC idempotency guard.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git"
  },
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "keywords": [
    "arki",
    "typescript",
    "offline",
    "offline-first",
    "pwa",
    "tanstack-query",
    "tanstack-db",
    "mutation-queue"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./query": {
      "types": "./dist/src/query/index.d.ts",
      "import": "./dist/src/query/index.js",
      "default": "./dist/src/query/index.js"
    },
    "./mutations": {
      "types": "./dist/src/mutations/index.d.ts",
      "import": "./dist/src/mutations/index.js",
      "default": "./dist/src/mutations/index.js"
    },
    "./collections": {
      "types": "./dist/src/collections/index.d.ts",
      "import": "./dist/src/collections/index.js",
      "default": "./dist/src/collections/index.js"
    },
    "./pwa": {
      "types": "./dist/src/pwa/index.d.ts",
      "import": "./dist/src/pwa/index.js",
      "default": "./dist/src/pwa/index.js"
    },
    "./status": {
      "types": "./dist/src/status/index.d.ts",
      "import": "./dist/src/status/index.js",
      "default": "./dist/src/status/index.js"
    },
    "./orpc": {
      "types": "./dist/src/orpc/index.d.ts",
      "node": "./dist/src/orpc/index.js",
      "browser": "./dist/src/orpc/index.browser.js",
      "default": "./dist/src/orpc/index.browser.js"
    },
    "./devtools": {
      "types": "./dist/src/devtools/index.d.ts",
      "import": "./dist/src/devtools/index.js",
      "default": "./dist/src/devtools/index.js"
    },
    "./preset": {
      "types": "./dist/src/preset/index.d.ts",
      "import": "./dist/src/preset/index.js",
      "default": "./dist/src/preset/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@arki/async": "0.3.0",
    "@arki/contracts": "0.4.1",
    "@arki/date": "0.5.0",
    "@arki/failure": "0.3.0",
    "@arki/log": "0.4.0",
    "@arki/resilience": "0.3.2",
    "@arki/schema": "0.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@tanstack/db": "^0.15.0",
    "@tanstack/query-async-storage-persister": "5.104.1",
    "@tanstack/query-persist-client-core": "^5.104.1",
    "@tanstack/react-db": "^0.5.10",
    "@tanstack/react-query-persist-client": "5.104.1",
    "idb-keyval": "^6.3.0",
    "superjson": "latest",
    "workbox-expiration": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "peerDependencies": {
    "@arki/db": "^0.5.1",
    "@orpc/contract": "^1.15.5",
    "@orpc/server": "^1.15.5",
    "@tanstack/react-query": "^5.104.1",
    "drizzle-orm": "^1.0.0-rc.4",
    "react": "^19.3.0"
  },
  "peerDependenciesMeta": {
    "@arki/db": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "arki": {
    "bundlerOnly": [
      "./pwa"
    ]
  }
}
